# Copy to .env and fill in. Never commit .env.

# --- providers (defaults are the real services) --------------------------
# EMBEDDER=fake LLM=fake VECTOR_STORE=memory runs fully offline (demo/tests).
EMBEDDER=gemini
LLM=openrouter
VECTOR_STORE=pgvector

# --- database (Neon: use the pooled connection string, sslmode=require) ---
# Ingest uses the owner URL here. The web service on Render uses the
# SELECT-only rag_reader URL instead (DATABASE_URL_READER below).
DATABASE_URL=
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_MAX_SIZE=4
# The web service never migrates by default; python -m app.ingest always does.
RUN_MIGRATIONS=false
# Written by tools/create_reader_role.py (run with OWNER_DATABASE_URL set);
# paste it into Render as DATABASE_URL. Not read by the app itself.
# DATABASE_URL_READER=

# --- embeddings: Gemini REST ---------------------------------------------
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_BATCH_SIZE=50
GEMINI_TIMEOUT_SECONDS=15

# --- chat: OpenRouter REST -----------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODELS=cohere/north-mini-code:free,google/gemma-4-31b-it:free
OPENROUTER_TIMEOUT_SECONDS=20
# "low" | "medium" | "high"; empty disables the reasoning hint
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_APP_URL=https://github.com/Abdullah-AbuHatab/jo-tax-law-rag
OPENROUTER_APP_TITLE=jo-tax-law-rag

# --- retrieval / answering -----------------------------------------------
# Refuse without calling the LLM when the best cosine similarity is below this.
MIN_SIMILARITY=0.60
DEFAULT_TOP_K=5
# Upstream time one question may use in total: the query embedding gets at most
# GEMINI_TIMEOUT_SECONDS (2 attempts), the LLM what is left (at most OPENROUTER_TIMEOUT_SECONDS).
ASK_DEADLINE_SECONDS=35

# --- HTTP ------------------------------------------------------------------
# Comma-separated origins; empty = no CORS (the UI is same-origin).
CORS_ALLOW_ORIGINS=
RATE_LIMIT_PER_MINUTE=10
# A header the edge overwrites with the real client IP; production (Render behind
# Cloudflare): cf-connecting-ip. Empty = not used, then TRUSTED_PROXY_HOPS applies.
CLIENT_IP_HEADER=
# 0 = use the socket peer IP; 1 behind one proxy that appends X-Forwarded-For.
TRUSTED_PROXY_HOPS=0
# /health/db answers only with header X-Health-Token equal to this; empty = always 404.
HEALTH_TOKEN=

# --- abuse and cost guards (daily counters reset at 00:00 UTC) ---------------
DAILY_ASK_LIMIT_PER_CLIENT=30
# LLM calls per client per day (cache hits and low-score refusals do not count).
DAILY_LLM_CALLS_PER_CLIENT=5
# Query embeddings / LLM calls per day across all clients; keep below your keys' quotas.
# Defaults sit just under the free tiers (Gemini embeddings ~1,000/day, OpenRouter free ~50/day).
DAILY_EMBEDDING_BUDGET=800
DAILY_LLM_BUDGET=45
MAX_CONCURRENT_ASKS=4
# 0 disables the answer cache.
ANSWER_CACHE_SIZE=500
ANSWER_CACHE_TTL_SECONDS=86400

# --- optional Cloudflare Turnstile on /ask (off unless BOTH are set) ----------
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- tests only --------------------------------------------------------------
# pgvector integration tests run only when this is set (they DROP law_chunks).
# TEST_DATABASE_URL=postgresql://postgres:test@localhost:55432/postgres
